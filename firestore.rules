rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token['admin'] == true;
    }

    // users/{uid}: read owner+admin; write owner (name, language, favourites);
    // role is set by server code only (10.1).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow update: if request.auth != null && request.auth.uid == uid;
    }

    // users/{uid}/private/contact: nobody from the client (C12); writes server-only.
    match /users/{uid}/private/contact {
      allow read: if false;
      allow write: if isAdmin();
    }

    // technicians/{uid}: public when approved; owner+admin otherwise; owner for
    // profile fields only, not approvalStatus, stats or badges.
    match /technicians/{uid} {
      allow read: if resource.data.approvalStatus == 'approved';
      allow read: if request.auth != null && request.auth.uid == uid;
      allow read: if isAdmin();
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    // bookings/{id}: client, assigned technician and admin read; writes go
    // through the API routes / state machine (7.4).
    match /bookings/{id} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.clientId || request.auth.uid == resource.data.technicianId) || isAdmin();
      allow write: if isAdmin();
    }

    // reviews/{id}: public when not hidden (10.1); server-only writes.
    match /reviews/{id} {
      allow read: if !resource.data.hidden;
      allow write: if isAdmin();
    }

    // rateTable and areas: public read.
    match /rateTable/{id} { allow read: if true; }
    match /areas/{id} { allow read: if true; }

    // complaints, events, audit: admin only (10.1).
    match /complaints/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /events/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /audit/{id} { allow read: if isAdmin(); allow write: if isAdmin(); }
  }
}
